# Copy to .env and edit. Every value is optional.

# live = real DNS queries; mock = scripted answers for every domain (offline demo)
DNSCOPE_RESOLVER_MODE=live
DNSCOPE_QUERY_TIMEOUT=2.0
DNSCOPE_QUERY_RETRIES=1

# Detection thresholds (see README "Calibrating thresholds")
DNSCOPE_WARMUP_CHECKS=5
DNSCOPE_TTL_LOW_RATIO=0.1
DNSCOPE_TTL_HIGH_RATIO=10
DNSCOPE_FAIL_COUNT=3
DNSCOPE_FAIL_WINDOW=5

# Optional AI explanations. Leave empty to use the built-in rule-based explanations.
ANTHROPIC_API_KEY=
DNSCOPE_AI_MODEL=claude-haiku-5-5

# DNSCOPE_DB_PATH=./dnscope.db
# DNSCOPE_CORS_ORIGINS=http://localhost:5173
